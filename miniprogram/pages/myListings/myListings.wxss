.ml-pub { margin-bottom: 24rpx; }

.ml-card { padding: 24rpx; }
.ml-thumb { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #F6F7F9; flex-shrink: 0; }
.ml-nothumb { display: flex; align-items: center; justify-content: center; }
.ml-title {
  font-size: 28rpx; font-weight: 500; line-height: 1.35; color: #171C24;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 1; overflow: hidden;
}
.ml-status { font-size: 24rpx; font-weight: 500; }

.ml-reason {
  background: #FBECEB;
  color: #CE3F36;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-top: 20rpx;
}

/* 操作行:小号文字按钮组,右对齐 */
.ml-ops {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  position: relative;
}
.ml-ops::before {
  content: '';
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 1px;
  background: #ECEEF2;
  transform: scaleY(0.5);
}
.ml-op {
  font-size: 24rpx;
  color: #454F5E;
  border: 1rpx solid #ECEEF2;
  border-radius: 999rpx;
  padding: 8rpx 26rpx;
}
.ml-op-primary { color: #C9490C; background: #FDEBE0; border-color: #FDEBE0; }
.ml-op-danger { color: #CE3F36; border-color: #F3CBC8; }
