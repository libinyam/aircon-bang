<view class="page">
  <view class="container">
    <button class="btn-ghost ml-pub" hover-class="hv-press" bindtap="goPublish">+ 发布商品</button>

    <view class="loading-wrap" wx:if="{{!loaded}}"><view class="spinner"></view><view>加载中…</view></view>

    <view class="empty" wx:if="{{loaded && loadError && !listings.length}}">
      <view class="ic il-net-error ic-big"></view>
      <view>加载失败,请检查网络</view>
      <button class="btn-ghost mt16 retry-btn" bindtap="retryLoad">重试</button>
    </view>
    <view class="empty" wx:elif="{{loaded && !listings.length}}">
      <view class="ic il-empty-goods ic-big"></view>
      <view>还没有发布过商品</view>
      <view class="text-sub mt8">回收的旧机、代理的新机都可以挂上来卖</view>
    </view>

    <view class="card ml-card" wx:for="{{listings}}" wx:key="_id">
      <view class="row row-top gap16" hover-class="hv-cell" bindtap="goDetail" data-id="{{item._id}}">
        <image class="ml-thumb" src="{{item.cover}}" mode="aspectFill" wx:if="{{item.cover}}" />
        <view class="ml-thumb ml-nothumb" wx:else><view class="ic ic-tab-shop"></view></view>
        <view class="flex-1">
          <view class="ml-title">{{item.title}}</view>
          <view class="row gap12 mt8">
            <view class="cond-tag {{item.condition === 'new' ? 'cond-new' : 'cond-used'}}">{{item.condText}}</view>
            <view class="goods-tag">{{item.specText}}</view>
          </view>
          <view class="row row-between mt8">
            <view class="price"><text class="price-sym">¥</text><text class="price-num">{{item.priceYuan}}</text></view>
            <text class="ml-status" style="color:{{item.statusColor}}">{{item.statusLabel}}</text>
          </view>
        </view>
      </view>

      <!-- 系统下架/违规原因 -->
      <view class="ml-reason" wx:if="{{item.reasonText}}">{{item.reasonText}}</view>

      <!-- 操作行 -->
      <view class="ml-ops" wx:if="{{item.canEdit || item.canDelete}}">
        <view class="ml-op" wx:if="{{item.canEdit}}" bindtap="editPrice" data-id="{{item._id}}">改价</view>
        <view class="ml-op" wx:if="{{item.canOffShelf}}" bindtap="offShelf" data-id="{{item._id}}">下架</view>
        <view class="ml-op" wx:if="{{item.canOnShelf}}" bindtap="onShelf" data-id="{{item._id}}">重新上架</view>
        <view class="ml-op ml-op-primary" wx:if="{{item.canSold}}" bindtap="markSold" data-id="{{item._id}}">已售出</view>
        <view class="ml-op ml-op-danger" wx:if="{{item.canDelete}}" bindtap="del" data-id="{{item._id}}">删除</view>
      </view>
    </view>
    <view class="text-sub list-end-sm" wx:if="{{listings.length && noMore}}">没有更多了</view>
  </view>
</view>
