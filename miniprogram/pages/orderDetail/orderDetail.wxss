.status-banner {
  border-radius: 24rpx;
  color: #fff;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.status-label { font-size: 36rpx; font-weight: 600; line-height: 1.3; }
.status-sub { font-size: 24rpx; opacity: 0.9; margin-top: 8rpx; }

.info-row { display: flex; font-size: 26rpx; margin-top: 10rpx; color: #454F5E; }
.info-label { color: #667180; width: 140rpx; flex-shrink: 0; }
.nav-link { color: #C9490C; }

.call-btn { height: 68rpx; line-height: 68rpx; padding: 0 26rpx; font-size: 26rpx; margin: 0; }

/* 星级:SVG 图标(替换 unicode ★) */
.stars-input { display: flex; }
.star-tap { width: 60rpx; height: 60rpx; margin-right: 12rpx; }
.stars-static { display: flex; }
.star-s { width: 34rpx; height: 34rpx; margin-right: 6rpx; }

.action-bar { display: flex; gap: 20rpx; margin-top: 8rpx; }
