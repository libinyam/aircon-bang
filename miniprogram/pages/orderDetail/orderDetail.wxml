<view class="container" wx:if="{{order}}">
  <!-- 状态横幅(v4.1 高端化:白底墨字大标题+状态呼吸点) -->
  <view class="status-banner">
    <view class="status-label">
      <view class="status-dot" style="background:{{statusMap[order.status].color}}"></view>
      <text>{{statusMap[order.status].label}}</text>
    </view>
    <view class="status-sub" wx:if="{{order.status === 'published'}}">等待同城师傅接单,接单后会通知您</view>
    <view class="status-sub" wx:if="{{order.status === 'accepted' && role === 'user'}}">师傅已接单,可电话联系约定上门</view>
    <view class="status-sub" wx:if="{{order.status === 'accepted' && role === 'master' && order.rejectCount}}">用户反馈未完成{{order.lastRejectReason ? ':' + order.lastRejectReason : ''}},请联系客户继续处理</view>
    <view class="status-sub" wx:if="{{order.status === 'pending_confirm' && role === 'user'}}">师傅已标记完成,请确认维修结果</view>
    <view class="status-sub" wx:if="{{order.status === 'pending_confirm' && role === 'master'}}">已提交完成,等待用户确认(72小时未确认将自动完成)</view>
    <view class="status-sub" wx:if="{{order.status === 'cancelled' && order.cancelReason}}">{{order.cancelReason}}</view>
  </view>

  <!-- 等待接单雷达(v4.1,滴滴式):published 单给双方视角;围观师傅看到的仍走抢单动线 -->
  <view class="radar-banner" wx:if="{{order.status === 'published' && role !== 'viewer'}}">
    <view class="radar-disc">
      <view class="radar-ring"></view>
      <view class="radar-ring radar-ring--2"></view>
      <view class="radar-ring radar-ring--3"></view>
      <view class="radar-core"><view class="ic ic-cat-{{order.category}}"></view></view>
    </view>
    <view class="radar-title">正在呼叫附近师傅</view>
    <view class="radar-sub">接单后微信通知你</view>
  </view>

  <!-- 状态时间轴(v4.1):用户/师傅视角渲染,围观视角信息量不足不渲染 -->
  <view class="tl card" wx:if="{{role !== 'viewer' && timeline.length && order.status !== 'published'}}">
    <view class="tl-node tl-node--{{item.state}}" wx:for="{{timeline}}" wx:key="label">
      <view class="tl-dot"><view class="tl-pulse"></view></view>
      <view class="tl-label">{{item.label}}</view>
      <view class="tl-time">{{item.time}}</view>
    </view>
  </view>

  <!-- 订单内容 -->
  <view class="card">
    <view class="row-between">
      <view class="text-strong scene-head">
        {{order.categoryName}}<text class="scene-tag {{order.scene === 'commercial' ? 'scene-tag--hot' : ''}}">{{sceneLabel}}</text>
      </view>
      <view class="text-sub">{{order.orderNo}}</view>
    </view>
    <view class="mt16">{{order.desc}}</view>
    <view class="photo-grid" wx:if="{{order.photos.length}}">
      <image wx:for="{{order.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill"
             bindtap="previewPhoto" data-src="{{item}}"/>
    </view>
    <view class="info-row mt16"><text class="info-label">上门时间</text>{{order.expectTime}}</view>
    <!-- 内嵌地图(v4.1):接单后订单定位点,点图即导航(openMap) -->
    <map wx:if="{{markers.length}}" class="order-map" markers="{{markers}}"
         latitude="{{markers[0].latitude}}" longitude="{{markers[0].longitude}}" scale="16"
         bindtap="openMap" aria-label="查看位置,点击导航"/>
    <view class="info-row" bindtap="openMap">
      <text class="info-label">地址</text>
      <view class="flex-1">{{order.address}}{{order.addressDetail ? ' ' + order.addressDetail : ''}}<text wx:if="{{role === 'master'}}" class="nav-link"> 导航</text><view class="ic ic-chev-o ic-xs" wx:if="{{role === 'master'}}"></view></view>
    </view>
    <view class="info-row"><text class="info-label">发布时间</text>{{publishedAtText}}</view>
  </view>

  <!-- 接单师傅信任卡(v4.1 墨色):头像/口碑前置,白色圆钮一键拨打 -->
  <view class="trust-card" wx:if="{{role === 'user' && order.masterName}}">
    <image class="trust-avatar" wx:if="{{masterStats.avatar}}" src="{{masterStats.avatar}}" mode="aspectFill"/>
    <view class="trust-avatar" wx:else>{{masterInitial}}</view>
    <view class="trust-main">
      <view class="trust-name-row">
        <text class="trust-name">{{order.masterName}}</text>
        <text class="trust-badge">平台师傅</text>
      </view>
      <view class="trust-stats" wx:if="{{masterStats}}">
        <block wx:if="{{masterStats.reviewCount}}">
          <view class="ic ic-star-gold trust-star"></view>
          <text class="trust-rating">{{avgStars}}</text>
          <text class="trust-dot">·</text>
          <text class="trust-done">完成 {{masterStats.done}} 单</text>
        </block>
        <text class="trust-done" wx:else>{{masterStats.done ? '完成 ' + masterStats.done + ' 单' : '新入驻师傅'}}</text>
      </view>
    </view>
    <view class="trust-call" hover-class="hv-press" bindtap="callPhone" data-phone="{{order.masterPhone}}"
          aria-role="button" aria-label="拨打电话给师傅">
      <view class="ic ic-phone-o trust-call-ic"></view>
    </view>
  </view>

  <!-- 客户信息(师傅视角,v4.1 浅色版与信任卡同构) -->
  <view class="card contact-card" wx:if="{{role === 'master'}}">
    <view class="contact-avatar">{{userInitial}}</view>
    <view class="contact-main">
      <view class="contact-name">{{order.userName || '客户'}}</view>
      <view class="contact-phone">{{order.userPhone}}</view>
    </view>
    <view class="contact-call" hover-class="hv-press" bindtap="callPhone" data-phone="{{order.userPhone}}"
          aria-role="button" aria-label="拨打电话给客户">
      <view class="ic ic-phone-o contact-call-ic"></view>
    </view>
  </view>

  <!-- 评价展示 -->
  <view class="card" wx:if="{{review}}">
    <view class="card-title">用户评价</view>
    <view class="stars-static" aria-label="{{review.stars}}星评价">
      <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
            class="ic {{review.stars >= item ? 'ic-star-on' : 'ic-star-off'}} star-s"></view>
    </view>
    <view class="mt8" wx:if="{{review.content}}">{{review.content}}</view>
  </view>

  <!-- 评价表单(用户,已完成未评价) -->
  <view class="card" wx:if="{{role === 'user' && order.status === 'completed' && !order.reviewed}}">
    <view class="card-title">评价本次服务</view>
    <view class="stars-input" aria-role="radiogroup" aria-label="选择评分">
      <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
            class="ic {{reviewStars >= item ? 'ic-star-on' : 'ic-star-off'}} star-tap"
            bindtap="setStars" data-n="{{item}}"
            aria-role="radio" aria-label="{{item}}星" aria-checked="{{reviewStars === item}}"></view>
    </view>
    <textarea class="form-textarea mt16" placeholder="师傅服务怎么样?说说你的体验(选填)"
              maxlength="300" value="{{reviewContent}}" bindinput="onReviewInput"/>
    <button class="btn-primary mt16" bindtap="submitReview" disabled="{{acting}}">提交评价</button>
  </view>

  <!-- 师傅视角状态提示:被驳回要显眼,待确认要有预期 -->
  <view class="card card-danger" wx:if="{{role === 'master' && order.status === 'accepted' && order.rejectCount > 0}}">
    <view class="text-strong text-danger">用户反馈服务未完成(第{{order.rejectCount}}次驳回)</view>
    <view class="text-sub mt8">{{order.lastRejectReason || '用户未填写原因'}}</view>
    <view class="text-sub mt8">请电话联系客户确认问题,处理完毕后再点"维修已完成"</view>
  </view>
  <view class="card" wx:if="{{role === 'master' && order.status === 'pending_confirm'}}">
    <view class="text-strong">已提交完成,等待用户确认</view>
    <view class="text-sub mt8">用户确认后订单完成;72小时未确认将自动完成。误点了可撤销。</view>
  </view>

  <!-- 余额不足提示(接单费制):可看单但不能接,和订单池口径一致 -->
  <view class="card card-danger" wx:if="{{role === 'viewer' && order.status === 'published' && balanceShortage}}">
    <view class="text-strong text-danger">钱包余额不足,暂不能接本单</view>
    <view class="text-sub mt8">接{{sceneLabel}}单需服务费 ¥{{feeText}},当前余额 ¥{{balanceText}};充值后即可接单。</view>
    <button class="btn-cta mt16" hover-class="hv-press" bindtap="goWallet">去充值</button>
  </view>

  <!-- 吸底操作面板(v4.1):主按钮全宽,次操作收进"更多";上缘发丝线+安全区 -->
  <view class="action-panel">
    <!-- 更多面板:次操作展开层(项按角色+状态由 buildMoreItems 适配) -->
    <view class="more-sheet" wx:if="{{moreOpen}}">
      <view class="more-item" hover-class="hv-cell" wx:for="{{moreItems}}" wx:key="fn"
            bindtap="onMoreAction" data-fn="{{item.fn}}">{{item.label}}</view>
    </view>

    <view class="action-row">
      <!-- 围观师傅:接单(按单扣费);余额不足转为充值引导,服务端 grabOrder 仍会校验 -->
      <button class="btn-primary flex-1" wx:if="{{role === 'viewer' && order.status === 'published'}}"
              hover-class="hv-press" bindtap="grab" disabled="{{acting}}">{{balanceShortage ? '余额不足,去充值' : '立即接单 ¥' + feeText}}</button>

      <!-- 用户:published 取消是唯一动作,直出主按钮;其余主操作=确认完成 -->
      <button class="btn-danger-ghost flex-1" wx:if="{{role === 'user' && order.status === 'published'}}"
              hover-class="hv-press" bindtap="cancel" disabled="{{acting}}">取消订单</button>
      <button class="btn-primary flex-1" wx:if="{{role === 'user' && order.status === 'pending_confirm'}}"
              hover-class="hv-press" bindtap="confirm" disabled="{{acting}}">确认完成</button>

      <!-- 师傅:主操作=维修已完成 / 撤销完成 -->
      <button class="btn-primary flex-1" wx:if="{{role === 'master' && order.status === 'accepted'}}"
              hover-class="hv-press" bindtap="finish" disabled="{{acting}}">维修已完成</button>
      <button class="btn-ghost flex-1" wx:if="{{role === 'master' && order.status === 'pending_confirm'}}"
              hover-class="hv-press" bindtap="undoFinish" disabled="{{acting}}">撤销完成</button>

      <view class="more-btn" hover-class="hv-cell" bindtap="toggleMore" aria-role="button" aria-label="更多操作"
            wx:if="{{(role === 'user' || role === 'master') && order.status !== 'published'}}">
        <view class="more-dots">···</view>
        <view class="more-btn-text">更多</view>
      </view>
    </view>
  </view>
  <view class="spacer40"></view>
</view>
<view class="empty" wx:elif="{{loadError}}" style="padding-top:200rpx">
  <view class="ic il-net-error ic-big"></view>
  <view>加载失败,请检查网络</view>
  <button class="btn-ghost mt16 retry-btn" bindtap="retryLoad">重试</button>
</view>
<view class="loading-wrap" wx:else style="padding-top:200rpx"><view class="spinner"></view><view>加载中…</view></view>
