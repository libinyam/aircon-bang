/* 顶部暖色渐变落在 page 上:未入驻/审核中等无 hall-head 的状态,
   导航栏(#FAF0E7)下也能平滑过渡到灰底,不出现色差断层 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FAF0E7 0%, #F8F3ED 160rpx, #FAF8F5 340rpx);
}
.container { padding: 24rpx; }

/* 招募页(墨色英雄区,呼应品牌正式感) */
.join-hero {
  background: linear-gradient(135deg, #1B212B, #3A4453);
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.join-title { font-size: 42rpx; font-weight: 600; line-height: 1.25; }
.join-sub { font-size: 26rpx; opacity: 0.65; margin-top: 10rpx; }
.jp { display: flex; align-items: flex-start; gap: 18rpx; padding: 18rpx 0; }
.jp .ic { margin-top: 6rpx; width: 44rpx; height: 44rpx; }
.jp-t { font-size: 30rpx; font-weight: 600; }

/* 审核状态卡(center-card 已上移 app.wxss) */
.state-circle {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: #F6F7F9;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 24rpx;
}
.state-circle .big-ic { width: 56rpx; height: 56rpx; }
.circle-red { background: #FBECEB; }

/* 大厅头部:暖色渐变(与首页同款,跨页一致) */
.hall-head {
  background: linear-gradient(180deg, #FAF0E7 0%, #F8F3ED 60%, #FAF8F5 100%);
  padding: 16rpx 24rpx 4rpx;
}
.filter-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 24rpx 8rpx 16rpx;
}
.cat-tabs { display: flex; gap: 34rpx; align-items: flex-end; }
/* 选中态只变字重与下划线,字号不变 → 切换零抖动 */
.cat-tab { font-size: 28rpx; color: #667180; padding-bottom: 12rpx; transition: color 0.2s ease; }
.cat-tab.on {
  font-weight: 600;
  color: #171C24;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding-bottom: 0;
}
.cat-tab-line { width: 40rpx; height: 6rpx; border-radius: 999rpx; background: #F25B15; }
.sort-toggle { font-size: 26rpx; color: #667180; padding-bottom: 6rpx; white-space: nowrap; }

.hall-body { padding: 4rpx 24rpx 0; }
.subs-btn { margin-bottom: 20rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; }

/* 我接的进行中订单:细条样式与首页 order-strip 同款,跨页一致 */
.sec-label {
  margin: 28rpx 8rpx 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #667180;
}
.my-strip {
  margin-top: 16rpx;
  background: #fff;
  border: 1rpx solid #ECEEF2;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.strip-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.strip-title { font-size: 28rpx; font-weight: 600; }
.strip-time { font-size: 24rpx; color: #667180; margin-left: 8rpx; }

/* 订单卡 */
.o-card { padding: 28rpx; }
.o-title { font-size: 32rpx; font-weight: 600; line-height: 1.3; color: #171C24; }
.o-badge {
  font-size: 24rpx;
  font-weight: 600;
  color: #C9490C;
  background: #FDEBE0;
  border-radius: 12rpx;
  padding: 4rpx 14rpx;
}
/* 家用/商用场景徽标:家用灰底低调,商用橙底实心醒目(¥300 的单值得多看一眼) */
.o-badge-plain { color: #667180; background: #F1F3F6; }
.o-badge-hot { color: #fff; background: #F25B15; }
.o-desc { font-size: 26rpx; color: #454F5E; margin-top: 10rpx; line-height: 1.5;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
/* 现场照片缩略行:与照片网格同语言的小号版,3 张 + 溢出计数 */
.o-thumbs { display: flex; gap: 12rpx; margin-top: 12rpx; }
.o-thumb { width: 96rpx; height: 96rpx; border-radius: 12rpx; background: #F6F7F9; }
.o-thumb-more {
  width: 96rpx; height: 96rpx; border-radius: 12rpx;
  background: #F1F3F6; color: #667180;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 500;
}
.o-dist { text-align: right; margin-left: 20rpx; flex-shrink: 0; }
.o-dist-num { font-size: 38rpx; font-weight: 800; color: #171C24; line-height: 1.1; font-feature-settings: "tnum"; }
.o-dist-num.near { color: #F25B15; }
.o-dist-unit { font-size: 24rpx; font-weight: 500; color: #667180; }
.o-dist-lb { font-size: 24rpx; color: #667180; margin-top: 4rpx; }
.o-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  position: relative;
}
/* 物理半像素分隔线(1px+scaleY(0.5),1rpx border 部分安卓机不渲染) */
.o-foot::before {
  content: '';
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 1px;
  background: #ECEEF2;
  transform: scaleY(0.5);
  transform-origin: 0 0;
}
/* 地址单行截断,长地址不再顶歪抢单按钮(v4 文字换行修复) */
.o-meta { font-size: 24rpx; color: #667180; flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.o-meta-addr { color: #454F5E; }
.o-foot .btn-cta-sm { flex-shrink: 0; margin-left: 20rpx; }

/* 缺品类提醒条(issue #165):琥珀底警示,与钱包警示条同色系 */
.cat-gap-bar {
  display: flex; align-items: center; gap: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  background: #FDF3E3;
  border-radius: 16rpx;
}
.cat-gap-text { font-size: 24rpx; color: #8A5A00; line-height: 1.5; }
.cat-gap-go { flex-shrink: 0; font-size: 24rpx; font-weight: 600; color: #C9490C; }
.cat-gap-close {
  flex-shrink: 0; width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(138, 90, 0, 0.35);
  display: flex; align-items: center; justify-content: center;
}
