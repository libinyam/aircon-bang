/* 顶部暖色渐变落在 page 上:未入驻/审核中等无 hall-head 的状态,
   导航栏(#FAF0E7)下也能平滑过渡到灰底,不出现色差断层 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FAF0E7 0%, #F8F3ED 160rpx, #F6F7F9 340rpx);
}
.container { padding: 24rpx; }

/* 招募页(墨色英雄区,呼应品牌正式感) */
.join-hero {
  background: linear-gradient(135deg, #1B212B, #3A4453);
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.join-title { font-size: 42rpx; font-weight: 600; line-height: 1.25; }
.join-sub { font-size: 26rpx; opacity: 0.65; margin-top: 10rpx; }
.jp { display: flex; align-items: flex-start; gap: 18rpx; padding: 18rpx 0; }
.jp .ic { margin-top: 6rpx; width: 44rpx; height: 44rpx; }
.jp-t { font-size: 30rpx; font-weight: 600; }

/* 审核状态卡(center-card 已上移 app.wxss) */
.state-circle {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: #F6F7F9;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 24rpx;
}
.state-circle .big-ic { width: 56rpx; height: 56rpx; }
.circle-red { background: #FBECEB; }

/* 大厅头部:暖色渐变(与首页同款,跨页一致) */
.hall-head {
  background: linear-gradient(180deg, #FAF0E7 0%, #F8F3ED 60%, #F6F7F9 100%);
  padding: 16rpx 24rpx 4rpx;
}
.filter-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 24rpx 8rpx 16rpx;
}
.cat-tabs { display: flex; gap: 34rpx; align-items: flex-end; }
/* 选中态只变字重与下划线,字号不变 → 切换零抖动 */
.cat-tab { font-size: 28rpx; color: #667180; padding-bottom: 12rpx; transition: color 0.2s ease; }
.cat-tab.on {
  font-weight: 600;
  color: #171C24;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding-bottom: 0;
}
.cat-tab-line { width: 40rpx; height: 6rpx; border-radius: 999rpx; background: #F25B15; }
.sort-toggle { font-size: 26rpx; color: #667180; padding-bottom: 6rpx; white-space: nowrap; }

.hall-body { padding: 4rpx 24rpx 0; }
.subs-btn { margin-bottom: 20rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; }

/* 订单卡 */
.o-card { padding: 28rpx; }
.o-title { font-size: 32rpx; font-weight: 600; line-height: 1.3; color: #171C24; }
.o-badge {
  font-size: 24rpx;
  font-weight: 600;
  color: #C9490C;
  background: #FDEBE0;
  border-radius: 12rpx;
  padding: 4rpx 14rpx;
}
.o-desc { font-size: 26rpx; color: #454F5E; margin-top: 10rpx; line-height: 1.5;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.o-dist { text-align: right; margin-left: 20rpx; flex-shrink: 0; }
.o-dist-num { font-size: 38rpx; font-weight: 800; color: #171C24; line-height: 1.1; font-feature-settings: "tnum"; }
.o-dist-num.near { color: #F25B15; }
.o-dist-unit { font-size: 24rpx; font-weight: 500; color: #667180; }
.o-dist-lb { font-size: 24rpx; color: #667180; margin-top: 4rpx; }
.o-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  position: relative;
}
/* 物理半像素分隔线(1px+scaleY(0.5),1rpx border 部分安卓机不渲染) */
.o-foot::before {
  content: '';
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 1px;
  background: #ECEEF2;
  transform: scaleY(0.5);
  transform-origin: 0 0;
}
.o-meta { font-size: 24rpx; color: #667180; }
.o-meta-addr { color: #454F5E; }
