.page { min-height: 100vh; }

/* ============ 品牌 hero(照片版/渐变回退双版本) ============ */
.hero { position: relative; overflow: hidden; }
/* 回退版:暖色渐变融入页面背景(去框框);低饱和窄跨度防 banding。
   顶部色 #FAF0E7 与接单大厅/买空调页头部同源,tab 间切换无色差 */
.hero--plain {
  background: linear-gradient(180deg, #FAF0E7 0%, #F8F3ED 55%, #F6F7F9 100%);
}
.hero-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
/* 照片版蒙版三层:顶部压暗保 tab 可读,左侧压暗托品牌文字,底部淡出到页面底色 */
.hero-scrim {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background:
    linear-gradient(180deg, rgba(23, 28, 36, 0.38) 0%, rgba(23, 28, 36, 0) 32%),
    linear-gradient(105deg, rgba(23, 28, 36, 0.55) 0%, rgba(23, 28, 36, 0.16) 52%, rgba(23, 28, 36, 0) 78%),
    linear-gradient(0deg, #F6F7F9 0%, rgba(246, 247, 249, 0) 20%);
}
.hero-inner { position: relative; padding: 8rpx 24rpx 4rpx; }

.role-tabs { display: flex; align-items: flex-end; gap: 34rpx; padding: 10rpx 8rpx 6rpx; }
.role-tab { font-size: 30rpx; font-weight: 500; color: #667180; padding-bottom: 12rpx; transition: color 0.2s ease; }
.role-tab.on {
  font-size: 36rpx;
  font-weight: 600;
  color: #171C24;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding-bottom: 0;
}
.role-line {
  width: 44rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: #F25B15;
}
.hero--photo .role-tab { color: rgba(255, 255, 255, 0.78); }
.hero--photo .role-tab.on { color: #fff; }

/* 问候语 → 品牌大字 → 信任口号:三级字号阶梯撑起 hero 的版式气场 */
.hero-hi {
  margin-top: 22rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: #96793B;
  line-height: 1.4;
}
.hero-brand {
  margin-top: 8rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  line-height: 1.2;
  color: #171C24;
}
/* 品牌句点:名字后的品牌橙小方块,品牌记忆点 */
.hero-mark { width: 14rpx; height: 14rpx; border-radius: 4rpx; background: #F25B15; flex-shrink: 0; }
.hero-slogan { margin-top: 12rpx; padding: 0 8rpx; font-size: 28rpx; letter-spacing: 1rpx; color: #454F5E; line-height: 1.45; }
.hero--photo .hero-hi { color: rgba(255, 255, 255, 0.82); }
.hero--photo .hero-brand { color: #fff; }
.hero--photo .hero-slogan { color: rgba(255, 255, 255, 0.88); }

/* 搜索发单入口:白胶囊直接嵌在 hero 上(参照严选/京东,去卡套卡) */
.search-card {
  margin-top: 20rpx;
  border-radius: 999rpx;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border: 1rpx solid #ECEEF2;
  border-radius: 999rpx;
  padding: 22rpx 30rpx;
}
/* 搜索胶囊视作浮层:暖色底与照片底上都给一层中性投影托起来 */
.hero--plain .search-box { box-shadow: 0 8rpx 24rpx rgba(23, 28, 36, 0.07); }
.hero--photo .search-box { border-color: transparent; box-shadow: 0 8rpx 24rpx rgba(23, 28, 36, 0.16); }
.search-ph { font-size: 30rpx; font-weight: 400; color: #A9B1BD; }

.body { padding: 0 24rpx 140rpx; }

/* 品类网格:图标直接放底上 */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 34rpx;
  padding: 34rpx 8rpx 8rpx;
}
.cat-cell { display: flex; flex-direction: column; align-items: center; gap: 14rpx; }
.cat-ic { width: 88rpx; height: 88rpx; }
.cat-name { font-size: 26rpx; color: #454F5E; font-weight: 500; }

/* 区块小标(进行中的单子) */
.sec-label {
  margin: 36rpx 8rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #667180;
}

/* 进行中订单细条 */
.order-strip {
  margin-top: 20rpx;
  background: #fff;
  border: 1rpx solid #ECEEF2;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.strip-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.strip-title { font-size: 28rpx; font-weight: 600; }
.strip-time { font-size: 24rpx; color: #667180; margin-left: 8rpx; }

/* CTA 横幅 */
.promo {
  margin-top: 28rpx;
  background: linear-gradient(100deg, #FA6E2A, #F25B15);
  border-radius: 24rpx;
  padding: 26rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 24rpx rgba(242, 91, 21, 0.25);
  color: #fff;
}
.promo-t { font-size: 32rpx; font-weight: 600; line-height: 1.3; letter-spacing: 1rpx; }
.promo-s { font-size: 24rpx; opacity: 0.85; margin-top: 4rpx; }
.promo-go {
  width: 92rpx; height: 92rpx;
  border-radius: 50%;
  background: #fff;
  color: #F25B15;
  font-size: 30rpx;
  font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}

/* 双列入口卡(买空调 / 师傅接单):竖版小卡打破横条堆叠的节奏 */
.dual-row {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.dual-card {
  background: #fff;
  border: 1rpx solid #ECEEF2;
  border-radius: 24rpx;
  padding: 28rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.dual-ic {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #FDEBE0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dual-ic .ic { width: 44rpx; height: 44rpx; }
.dual-ic--green { background: #E3F2EC; }
.dual-t { margin-top: 18rpx; font-size: 30rpx; font-weight: 600; line-height: 1.3; color: #171C24; }
.dual-s { margin-top: 6rpx; font-size: 24rpx; line-height: 1.5; color: #667180; }
.dual-go {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #C9490C;
}
.dual-card--green .dual-go { color: #0E7A4F; }

.footer-tip { text-align: center; color: #A9B1BD; font-size: 24rpx; padding: 28rpx 0 8rpx; }
