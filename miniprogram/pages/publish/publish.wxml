<view class="page">
  <!-- 万师傅参考: 顶部价格信任条 -->
  <view class="trust-bar">
    <view class="trust-item"><view class="ic ic-check-w trust-item-ic"></view><text>免费发布</text></view>
    <view class="trust-sep">·</view>
    <view class="trust-item"><view class="ic ic-check-w trust-item-ic"></view><text>师傅快速响应</text></view>
    <view class="trust-sep">·</view>
    <view class="trust-item"><view class="ic ic-check-w trust-item-ic"></view><text>当面谈价满意再修</text></view>
  </view>

  <view class="body">
    <!-- 服务类型: 6 大品类磁贴(可多选) -->
    <view class="card">
      <view class="sec-head">
        <view class="sec-title">需要什么服务?(可多选)</view>
        <view class="sec-tip">按需组合</view>
      </view>
      <view class="svc-row">
        <view class="svc-cell {{item.on ? 'svc-on' : ''}}"
              wx:for="{{categories}}" wx:key="key"
              bindtap="pickCategory" data-key="{{item.key}}">
          <view class="ic ic-cat-{{item.key}} svc-ic"></view>
          <text class="svc-name">{{item.shortName}}</text>
          <view class="svc-check" wx:if="{{item.on}}"><view class="ic ic-check-w ic-xs"></view></view>
        </view>
      </view>

      <view class="divider"></view>

      <!-- 设备类型 8 选 1 -->
      <view class="sec-head">
        <view class="sec-title">修什么设备?</view>
        <view class="sec-tip">单选</view>
      </view>
      <view class="equip-grid">
        <view class="scene-cell {{form.equipType === item.key ? 'scene-on' : ''}}"
              wx:for="{{equipTypes}}" wx:key="key"
              bindtap="pickEquip" data-key="{{item.key}}">
          <text class="scene-name">{{item.name}}</text>
          <text class="scene-sub">{{item.tip}}</text>
          <view class="svc-check" wx:if="{{form.equipType === item.key}}"><view class="ic ic-check-w ic-xs"></view></view>
        </view>
      </view>

      <view class="divider"></view>

      <!-- 故障描述 + 快捷标签 -->
      <view class="sec-head">
        <view class="sec-title">空调怎么了?</view>
        <view class="sec-tip">支持点选标签</view>
      </view>
      <textarea class="form-textarea mt16" placeholder="例: 格力挂机,开机后不制冷,外机风扇不转,用了大概5年"
                maxlength="500" value="{{form.desc}}" bindinput="onInput" data-field="desc"/>
      <view class="sym-row">
        <view class="sym-chip" wx:for="{{symptoms}}" wx:key="*this"
              bindtap="addSymptom" data-s="{{item}}">+ {{item}}</view>
      </view>

      <!-- 照片 -->
      <view class="photo-grid">
        <image wx:for="{{photos}}" wx:key="*this" src="{{item}}" mode="aspectFill"
               bindtap="previewPhoto" data-src="{{item}}"/>
        <view class="photo-add" bindtap="addPhoto" wx:if="{{photos.length < 6}}">
          <view class="ic ic-plus-g photo-add-ic"></view>
          <text class="photo-add-lb">拍一张 {{photos.length}}/6</text>
        </view>
      </view>
    </view>

    <!-- 地址 / 时间 / 联系方式: 合并列表卡 -->
    <view class="card list-card">
      <view class="li" bindtap="chooseLocation">
        <view class="li-dot li-dot-addr"></view>
        <view class="flex-1">
          <text wx:if="{{form.address}}" class="li-main">{{form.address}}</text>
          <text wx:else class="li-ph">点击选择上门地址</text>
        </view>
        <view class="ic ic-chev ic-sm"></view>
      </view>
      <view class="li" wx:if="{{form.address}}">
        <view class="li-dot li-dot-empty"></view>
        <input class="li-input flex-1" placeholder="门牌号等补充信息(选填,仅接单师傅可见)"
               value="{{form.addressDetail}}" bindinput="onInput" data-field="addressDetail"/>
      </view>
      <view class="li">
        <view class="li-dot li-dot-time"></view>
        <picker class="flex-1" mode="date" start="{{today}}" bindchange="pickDate">
          <text wx:if="{{form.date}}" class="li-main">{{form.date}}</text>
          <text wx:else class="li-ph">选择上门日期</text>
        </picker>
        <picker range="{{timeSlots}}" bindchange="pickSlot">
          <text wx:if="{{form.slot}}" class="li-main">{{form.slot}}</text>
          <text wx:else class="li-ph">选时段</text>
        </picker>
        <view class="ic ic-chev ic-sm"></view>
      </view>
      <view class="li">
        <view class="li-dot li-dot-phone"></view>
        <input class="li-input flex-1" type="number" maxlength="11" placeholder="联系手机号"
               value="{{form.phone}}" bindinput="onInput" data-field="phone"/>
      </view>
      <view class="li">
        <view class="li-dot li-dot-phone"></view>
        <input class="li-input flex-1" placeholder="称呼(选填)" maxlength="10"
               value="{{form.contactName}}" bindinput="onInput" data-field="contactName"/>
        <text class="li-note">仅接单师傅可见</text>
      </view>
    </view>
  </view>

  <!-- 吸底发单栏 -->
  <view class="sticky-bar">
    <button class="btn-cta" hover-class="hv-press" bindtap="submit" disabled="{{submitting}}">
      {{submitting ? '发布中…' : '立即免费发单'}}
    </button>
    <view class="sticky-note">费用与师傅当面结算 · 平台不代收中介费</view>
  </view>
</view>
