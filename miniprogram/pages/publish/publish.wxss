.page { padding-bottom: 220rpx; background: #FAF8F5; }

/* 价格与服务信任条 (万师傅风格) */
.trust-bar {
  background: #FFF5EB;
  border-bottom: 1rpx solid rgba(242, 91, 21, 0.12);
  padding: 14rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.trust-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #C9490C;
}
.trust-item-ic {
  width: 22rpx;
  height: 22rpx;
  background-color: #F25B15;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.trust-sep { color: rgba(201, 73, 12, 0.4); font-size: 20rpx; }

.body { padding: 16rpx 24rpx 0; }

.sec-head { display: flex; align-items: center; justify-content: space-between; }
.sec-title { font-size: 30rpx; font-weight: 600; line-height: 1.3; color: #171C24; }
.sec-tip { font-size: 22rpx; color: #8F9BB3; }

/* 半像素分隔线 */
.divider { height: 1px; background: #ECEEF2; transform: scaleY(0.5); margin: 30rpx 0 26rpx; }

/* 服务类型磁贴: 6 品类 3 列两行 */
.svc-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 20rpx; }

/* 设备类型 8 格: 两列四行 */
.equip-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-top: 20rpx; }
.scene-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 22rpx 12rpx 20rpx;
  background: #F6F7F9;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  position: relative;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}
.scene-on { background: #FFF6F2; border-color: #F25B15; }
.scene-name { font-size: 28rpx; font-weight: 500; color: #667180; }
.scene-on .scene-name { font-weight: 600; color: #C9490C; }
.scene-sub { font-size: 22rpx; color: #98A1AC; }
.svc-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 0 18rpx;
  background: #F6F7F9;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  position: relative;
  transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}
.svc-on { background: #FFF6F2; border-color: #F25B15; box-shadow: 0 4rpx 12rpx rgba(242,91,21,0.08); }
.svc-ic { width: 68rpx; height: 68rpx; border-radius: 16rpx; }
.svc-name { font-size: 24rpx; font-weight: 500; color: #667180; }
.svc-on .svc-name { font-weight: 600; color: #C9490C; }
.svc-check {
  position: absolute;
  top: -2rpx; right: -2rpx;
  width: 30rpx; height: 30rpx;
  border-radius: 0 16rpx 0 16rpx;
  background: #F25B15;
  display: flex; align-items: center; justify-content: center;
}

/* 故障快捷标签 */
.sym-row { display: flex; gap: 12rpx; margin-top: 18rpx; flex-wrap: wrap; }
.sym-chip {
  font-size: 24rpx;
  color: #667180;
  background: #F6F7F9;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  transition: background-color 0.2s ease, color 0.2s ease;
}
.sym-chip:active { color: #C9490C; background: #FDEBE0; }

/* 合并列表卡 */
.list-card { padding: 4rpx 28rpx; }
.li {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 0;
  position: relative;
}
.li::after {
  content: '';
  position: absolute;
  left: 38rpx; right: 0; bottom: 0;
  height: 1px;
  background: #ECEEF2;
  transform: scaleY(0.5);
  transform-origin: 0 100%;
}
.li:last-child::after { display: none; }
.li-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.li-dot-addr { background: #0E9868; }
.li-dot-time { background: #F25B15; }
.li-dot-phone { background: #3D6FD1; }
.li-dot-empty { background: transparent; }
.li-main { font-size: 28rpx; font-weight: 600; }
.li-ph { font-size: 28rpx; color: #A9B1BD; }
.li-input { font-size: 28rpx; }
.li-note { font-size: 24rpx; color: #667180; flex-shrink: 0; }
