.page { padding-bottom: 220rpx; }
.head-note { text-align: center; font-size: 24rpx; color: #667180; padding: 14rpx 0 4rpx; }
.body { padding: 8rpx 24rpx 0; }

.sec-title { font-size: 30rpx; font-weight: 600; line-height: 1.3; color: #171C24; }
/* 半像素分隔线(1px+scaleY(0.5)) */
.divider { height: 1px; background: #ECEEF2; transform: scaleY(0.5); margin: 30rpx 0 26rpx; }

/* 服务类型四小磁贴 */
.svc-row { display: flex; gap: 16rpx; margin-top: 22rpx; }

/* 家用/商用两格(横向文字格,与服务类型磁贴同一套选中语言) */
.scene-row { display: flex; gap: 16rpx; margin-top: 22rpx; }
.scene-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 22rpx 12rpx 20rpx;
  background: #F6F7F9;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  position: relative;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}
.scene-on { background: #FDEBE0; border-color: #F25B15; }
.scene-name { font-size: 28rpx; font-weight: 500; color: #667180; }
.scene-on .scene-name { font-weight: 600; color: #C9490C; }
.scene-sub { font-size: 22rpx; color: #98A1AC; }
.svc-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 0 18rpx;
  background: #F6F7F9;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  position: relative;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}
.svc-on { background: #FDEBE0; border-color: #F25B15; }
.svc-ic { width: 52rpx; height: 52rpx; }
.svc-name { font-size: 24rpx; font-weight: 500; color: #667180; }
.svc-on .svc-name { font-weight: 600; color: #C9490C; }
.svc-check {
  position: absolute;
  top: -2rpx; right: -2rpx;
  width: 32rpx; height: 32rpx;
  border-radius: 0 16rpx 0 16rpx;
  background: #F25B15;
  display: flex; align-items: center; justify-content: center;
}

/* 故障快捷标签 */
.sym-row { display: flex; gap: 12rpx; margin-top: 18rpx; flex-wrap: wrap; }
.sym-chip {
  font-size: 24rpx;
  color: #667180;
  background: #F6F7F9;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  transition: background-color 0.2s ease, color 0.2s ease;
}
.sym-chip:active { color: #C9490C; background: #FDEBE0; }

/* 合并列表卡 */
.list-card { padding: 4rpx 28rpx; }
.li {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 0;
  position: relative;
}
/* 半像素分隔线,左缩进 38rpx(圆点 16 + 间距 22)对齐文字起点 */
.li::after {
  content: '';
  position: absolute;
  left: 38rpx; right: 0; bottom: 0;
  height: 1px;
  background: #ECEEF2;
  transform: scaleY(0.5);
  transform-origin: 0 100%;
}
.li:last-child::after { display: none; }
.li-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.li-dot-addr { background: #0E9868; }
.li-dot-time { background: #F25B15; }
.li-dot-phone { background: #3D6FD1; }
.li-dot-empty { background: transparent; }
.li-main { font-size: 28rpx; font-weight: 600; }
.li-ph { font-size: 28rpx; color: #A9B1BD; }
.li-input { font-size: 28rpx; }
.li-note { font-size: 24rpx; color: #667180; flex-shrink: 0; }
