<view class="page">
  <view class="loading-wrap" wx:if="{{!loaded}}"><view class="spinner"></view><view>加载中…</view></view>

  <!-- 网络错误 -->
  <view class="container" wx:elif="{{loadError}}">
    <view class="card center-card">
      <view class="ic il-net-error ic-big"></view>
      <view class="state-title mt8">加载失败</view>
      <view class="text-sub mt8">网络异常,请重试</view>
      <button class="btn-ghost mt24 retry-btn" bindtap="retryLoad">重试</button>
    </view>
  </view>

  <!-- 商品不存在/已删除/已下架:分享链接可能指向已删商品,渲染专用空态 -->
  <view class="container" wx:elif="{{!listing}}">
    <view class="card center-card">
      <view class="ic il-empty-goods ic-big"></view>
      <view class="state-title mt8">{{notFoundMsg || '商品不存在或已删除'}}</view>
      <view class="text-sub mt8">去市场看看其他在售空调吧</view>
    </view>
  </view>

  <block wx:else>
    <!-- 轮播:全宽 1:1,点按可预览大图 -->
    <swiper class="ld-swiper" indicator-dots="{{listing.photos.length > 1}}" indicator-active-color="#F25B15" circular>
      <swiper-item wx:for="{{listing.photos}}" wx:key="*this">
        <image class="ld-photo" src="{{item}}" mode="aspectFill" bindtap="previewPhoto" data-src="{{item}}" />
      </swiper-item>
    </swiper>

    <view class="container ld-body">
      <!-- 天猫式价格头卡 -->
      <view class="card">
        <view class="row row-between">
          <view class="price price-lg"><text class="price-sym">¥</text><text class="price-num">{{listing.priceYuan}}</text></view>
          <view class="cond-tag {{listing.condition === 'new' ? 'cond-new' : 'cond-used'}}">{{condText}}</view>
        </view>
        <view class="ld-title">{{listing.title}}</view>
        <view class="text-sub mt8" wx:if="{{listing.listingNo}}">商品编号 {{listing.listingNo}}</view>
      </view>

      <!-- 已售出横幅 -->
      <view class="ld-sold-banner" wx:if="{{isSold}}">该商品已售出,去市场看看其他在售空调</view>

      <!-- 参数表 -->
      <view class="card ld-params">
        <view class="card-title">商品参数</view>
        <view class="ld-param-row" wx:for="{{params}}" wx:key="label">
          <text class="ld-param-lb">{{item.label}}</text>
          <text class="ld-param-val">{{item.value}}</text>
        </view>
      </view>

      <!-- 卖家信任卡(淘宝店铺卡式):有展示头像用真头像,没有回退文字头像 -->
      <view class="card">
        <view class="row gap16">
          <image class="ld-avatar" src="{{sellerAvatar}}" mode="aspectFill" wx:if="{{sellerAvatar}}" />
          <view class="ld-avatar" wx:else>{{avatarText}}</view>
          <view class="flex-1">
            <view class="row gap12">
              <text class="ld-seller-name">{{listing.sellerDisplayName || '平台师傅'}}</text>
              <view class="chip chip-blue" wx:if="{{sellerVerified}}">平台认证师傅</view>
              <view class="chip chip-green" wx:if="{{sellerVerified}}">已实名</view>
            </view>
            <view class="text-sub mt8" wx:if="{{sellerStats}}">
              完成 {{sellerStats.done || 0}} 单{{avgStars ? ' · 评分 ' + avgStars : ''}}
            </view>
          </view>
        </view>
      </view>

      <!-- 图文详情 -->
      <view class="card">
        <view class="card-title">商品描述</view>
        <view class="ld-desc">{{listing.desc}}</view>
      </view>

      <!-- 合规提示 + 举报 -->
      <view class="ld-notice">
        <view class="ld-notice-t">交易提醒</view>
        <view class="ld-notice-p">当面验货后再付款,平台不代收任何款项</view>
        <view class="ld-report" bindtap="report">举报该商品</view>
      </view>
      <view class="spacer40"></view>
    </view>

    <!-- 吸底栏 -->
    <view class="sticky-bar">
      <view class="row gap16" wx:if="{{isOwner}}">
        <button class="btn-ghost flex-1" hover-class="hv-press" bindtap="goManage">管理我的商品</button>
      </view>
      <view class="row gap16" wx:elif="{{isOnSale}}">
        <button class="ld-share-btn" open-type="share" hover-class="hv-press">
          <view class="ic ic-share-f"></view>
          <view class="ld-share-lb">分享</view>
        </button>
        <button class="btn-cta flex-1" hover-class="hv-press" bindtap="contact" disabled="{{acting}}">
          {{acting ? '获取中…' : '电话联系卖家'}}
        </button>
      </view>
      <view class="ld-sold-bar" wx:else>该商品已售出</view>
    </view>
  </block>
</view>
