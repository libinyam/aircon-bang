/* 运营体检卡 */
.health-card { padding: 20rpx 24rpx; }
.health-row { gap: 16rpx; flex-wrap: wrap; font-size: 24rpx; }
.text-ok { color: #0E9868; }
.text-warn { color: #9A6503; }
.err-card { color: #CE3F36; text-align: center; }

.seg {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #667180;
  border-radius: 12rpx;
}
.seg-active { background: #F25B15; color: #fff; font-weight: 600; }

.action-row { display: flex; gap: 20rpx; }

/* 资质照片带材料类型标注(qualTypes);图片尺寸沿用全局 .photo-grid image */
.qual-item { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.qual-item-label { font-size: 24rpx; color: #667180; }
.desc-line {
  color: #454F5E;
  font-size: 26rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.grant-panel {
  background: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}
.month-chip {
  padding: 14rpx 32rpx;
  background: #F6F7F9;
  border-radius: 999rpx;
  font-size: 26rpx;
  border: 2rpx solid transparent;
}
.chip-active {
  background: #FDEBE0;
  color: #C9490C;
  border-color: #F25B15;
  font-weight: 600;
}

/* 商品分区缩略图(买空调频道) */
.al-thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #F6F7F9; flex-shrink: 0; }
