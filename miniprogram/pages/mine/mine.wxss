/* 顶部暖色渐变落在 page 上(与首页/接单大厅/买空调同源 #FAF0E7):
   登录失败态无 mine-head 时导航栏下也能平滑过渡到灰底,不出现色差断层 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FAF0E7 0%, #F8F3ED 160rpx, #F6F7F9 340rpx);
}

.mine-head {
  background: linear-gradient(180deg, #FAF0E7 0%, #F8F3ED 55%, #F6F7F9 100%);
  padding: 20rpx 28rpx 104rpx;
}
.prof-row { display: flex; align-items: center; gap: 24rpx; padding-top: 8rpx; }
.avatar {
  width: 112rpx; height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FAE3D2, #F3C4A4);
  color: #9C480E;
  font-size: 46rpx;
  font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
/* 展示头像:认证师傅可点击补传/更换,右下角角标提示 */
.avatar-box { position: relative; flex-shrink: 0; }
.avatar-edit {
  position: absolute;
  right: -8rpx; bottom: -4rpx;
  font-size: 20rpx;
  color: #fff;
  background: #F25B15;
  border: 2rpx solid #fff;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  line-height: 1.4;
}
.prof-name { font-size: 38rpx; font-weight: 600; line-height: 1.25; color: #171C24; }
.prof-sub { font-size: 24rpx; color: #667180; margin-top: 8rpx; }
.chip { font-size: 24rpx; font-weight: 600; border-radius: 999rpx; padding: 6rpx 18rpx; }
.chip-blue { color: #3D6FD1; background: #E9EFFA; }
.chip-green { color: #0E9868; background: #E3F2EC; }
.chip-amber { color: #9A6503; background: #F7EDDA; }

.stats-row { display: flex; padding: 32rpx 4rpx 28rpx; }
.stat-num { font-size: 40rpx; font-weight: 800; line-height: 1.1; color: #171C24; font-feature-settings: "tnum"; }
.stat-gold { color: #C9932B; }
.stat-lb { font-size: 24rpx; color: #667180; margin-left: 10rpx; }

.body { padding: 8rpx 24rpx 160rpx; }
/* 首卡叠压进头部渐变尾段(Gitter 手法);登录失败态的 body 不带此类,不受影响 */
.body-overlap { margin-top: -88rpx; padding-top: 0; }

/* 身份入口：服务用户申请入驻，认证师傅直达接单大厅 */
.role-state-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #E6E9EE;
}
.role-state-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #5F789C;
  box-shadow: 0 0 0 8rpx rgba(95, 120, 156, .12);
}
.role-state-dot--master {
  background: #F25B15;
  box-shadow: 0 0 0 8rpx rgba(242, 91, 21, .12);
}
.role-state-title { color: #171C24; font-size: 28rpx; font-weight: 600; }
.role-state-sub { margin-top: 6rpx; color: #667180; font-size: 22rpx; }
.role-state-action { color: #C9490C; font-size: 22rpx; font-weight: 600; }

/* 分组竖排列表 */
.list-card { margin-top: 20rpx; padding: 8rpx 28rpx; }
.cell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  position: relative;
  transition: background-color 0.2s ease;
}
/* 半像素分隔线,左缩进 64rpx(图标 44 + 间距 20)对齐文字起点 */
.cell::after {
  content: '';
  position: absolute;
  left: 64rpx; right: 0; bottom: 0;
  height: 1px;
  background: #ECEEF2;
  transform: scaleY(0.5);
  transform-origin: 0 100%;
}
.cell:last-child::after { display: none; }
.cell-ic { width: 44rpx; height: 44rpx; }
.cell-t { font-size: 30rpx; font-weight: 500; color: #171C24; flex: 1; text-align: left; }
.cell-hint { font-size: 24rpx; color: #C9490C; }
/* 分享行:button 必须是本体,不能用透明覆盖层
   (覆盖层写法下父 view 的 hover-class 不生效,且 opacity:0 连 button 默认 button-hover
    也一起隐藏 → 整行零按压反馈,被当成功能失效)。
   但 button 组件自带的居中布局(左右内边距 + margin auto + 居中对齐)优先级高于
   页面的普通类选择器,页面里写 display/padding 抢不过它:行内容被收成居中一坨,
   图标往右挪、箭头往左缩,跟上下几行差一大截(2026-08「推荐给朋友没有对齐」)。
   所以这里不再跟它抢容器类型,只做两件能确定赢的事:
   1) 把决定左右位置的三项(对齐/内边距/外边距)提到 !important —— 作者 !important
      的层叠优先级高于组件自带声明,普通类选择器不行;
   2) 让里层 .cell 在 block 和 flex 两种容器下都撑满整行(width + flex 各管一种),
      这样不论 button 最终算成哪种盒子,行布局都由 .cell 说话,与其他 cell 同一套 flex */
.share-cell {
  /* display 与 width 也必须提权:上一版这两项写成普通声明,按钮被收成内容宽度
     (shrink-wrap),于是图标虽已左对齐、箭头却紧跟文字停住,到不了卡片右缘
     (2026-08「箭头还是没有靠最右」)。行宽锁死后,撑开文字挤走箭头这套机制
     才和其他 cell 一样成立 */
  display: flex !important;
  width: 100% !important;
  box-sizing: border-box;
  justify-content: flex-start !important;  /* 组件默认居中,必须提权顶掉 */
  align-items: stretch;
  padding: 0 !important;                   /* 组件默认左右内边距,同上 */
  margin: 0 !important;                    /* 组件默认 margin auto 会把整行推向中间 */
  background: transparent;
  border: none;
  border-radius: 0;
  text-align: left;
  font-size: 28rpx;
  line-height: 1.6;
  color: #171C24;
  overflow: visible;
}
/* button 默认 ::after 是那圈 1px 边框叠层,整行外壳不需要 */
.share-cell::after { display: none; }
/* 里层 .cell 撑满:button 算 flex 时靠 flex,算 block 时靠 width。
   同样要提权 —— 普通声明在 button 内部不可靠(上一轮已验证 !important 才稳) */
.share-cell .cell {
  display: flex !important;
  width: 100% !important;
  flex: 1 1 auto !important;
  box-sizing: border-box;
}
/* 箭头要贴卡片右缘。其他行靠 .cell-t 的 flex:1 把文字撑开、顺势把箭头挤到最右;
   但在 button 里文字没被撑开,箭头就紧挨着文字停住(2026-08「箭头没放在最右端」)。
   所以不指望文字伸缩,直接把箭头 margin-left 设成 auto 顶到最右 —— 这条与
   .cell-t 的 flex 各保一头,任一生效箭头都在右缘 */
.share-cell .cell-t { flex: 1 1 auto !important; min-width: 0; }
.share-cell .ic-chev { margin-left: auto !important; flex-shrink: 0; }
/* 里层 .cell 是 button 的唯一子元素,会命中 .cell:last-child::after 被抹掉分隔线;
   分享行后面永远还有"联系客服",这条线必须留着 */
.share-cell .cell::after { display: block; }
/* hover 态必须提权:.hv-cell 在 app.wxss,.share-cell 在页面 wxss(后加载),
   同为单类选择器时后者胜出会把 hover 底色顶掉 */
.share-cell.hv-cell { background: rgba(23, 28, 36, 0.05); }

.openid-row { text-align: center; padding: 30rpx 0 20rpx; }
